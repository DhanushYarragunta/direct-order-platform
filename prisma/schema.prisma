generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  KITCHEN
  MANAGER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  PREPARING
  READY
  HANDED_OFF
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  REFUND_PENDING
}

enum CateringStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  deletedAt     DateTime?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  name          String
  passwordHash  String
  role          Role      @default(CUSTOMER)
  outletId      String?
  outlet        Outlet?   @relation(fields: [outletId], references: [id])
  consentAt     DateTime?
  marketingOptIn Boolean  @default(false)
  createdAt     DateTime  @default(now())
  sessions      Session[]
  passwordResets PasswordReset[]
  orders        Order[]
  audits        Audit[]
  loyaltyEntries LoyaltyEntry[]
  cateringRequests CateringRequest[]
  addresses     SavedAddress[]
  favorites     Favorite[]
}

model Favorite {
  userId String
  itemId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, itemId])
  @@index([itemId])
}

model SavedAddress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String
  recipientName String
  phone         String
  addressLine   String
  area          String
  city          String
  pincode       String   @default("")
  latitude      Float
  longitude     Float
  localityId    String?
  locationKind  String   @default("place")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([userId, createdAt])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model Outlet {
  id            String @id
  name          String
  address       String
  city          String @default("Hyderabad")
  latitude      Float
  longitude     Float
  radiusKm      Float  @default(5)
  minPrepMinutes Int   @default(25)
  activeStations Int   @default(4)
  fssai         String
  fssaiVerified Boolean @default(false)
  deliveryFeePaise Int @default(4000)
  minDeliveryPaise Int @default(19900)
  freeDeliveryAbovePaise Int @default(59900)
  open          Boolean @default(true)
  updatedAt     DateTime @updatedAt
  users         User[]
  orders        Order[]
  availability  Availability[]
  channelBaselines ChannelBaseline[]
  cateringRequests CateringRequest[]
}

model MenuItem {
  id          String @id @default(cuid())
  name        String
  description String
  category    String
  pricePaise  Int
  familyPricePaise Int?
  portion     String
  vegetarian  Boolean
  spice       String
  allergens   String[]
  photo       String?
  prepMinutes Int
  active      Boolean @default(true)
  featured    Boolean @default(false)
  menuDays    Int[] @default([])
  menuStartMinute Int?
  menuEndMinute Int?
  cityPrices MenuCityPrice[]
  updatedAt   DateTime @updatedAt
  availability Availability[]
  favorites Favorite[]
  @@index([active, category])
}

model Availability {
  outletId String
  itemId   String
  available Boolean @default(true)
  updatedAt DateTime @updatedAt
  outlet   Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  item     MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@id([outletId, itemId])
}

model AddOn {
  id          String @id
  name        String
  pricePaise  Int
  prepMinutes Int
  allergens   String[]
  active      Boolean @default(true)
}

model Order {
  id           String @id @default(cuid())
  number       String @unique
  userId       String
  user         User @relation(fields: [userId], references: [id])
  outletId     String
  outlet       Outlet @relation(fields: [outletId], references: [id])
  checkoutKey  String
  cartHash     String
  status       OrderStatus @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(PENDING)
  totalPaise   Int
  deliveryFeePaise Int @default(0)
  deliveryLocalityId String?
  checkoutStartedAt DateTime?
  checkoutDurationMs Int?
  checkoutMetricSource String?
  deliveredAt DateTime?
  subtotalPaise Int @default(0)
  couponCode String?
  couponFirstOrderOnly Boolean @default(false)
  couponDiscountPaise Int @default(0)
  redeemedPoints Int @default(0)
  gstPaise     Int
  workMinutes  Int
  fulfillment  String
  address      String
  phone        String
  note         String
  promisedAt   DateTime?
  originalPromisedAt DateTime?
  estimateSource String?
  estimateModelVersion String?
  estimateQueueWork Int?
  estimateStations Int?
  estimateMinimumMinutes Int?
  estimateHour Float?
  estimateRawMinutes Float?
  estimateTrainingSamples Int?
  estimateValidationMae Float?
  estimateBaselineMae Float?
  estimateMinutes Int?
  estimateFallback Boolean @default(false)
  expiresAt    DateTime
  readyAt      DateTime?
  placedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  version      Int @default(0)
  lines        OrderLine[]
  payments     Payment[]
  gatewayOrder GatewayOrder?
  messages     Message[]
  audits       Audit[]
  loyaltyEntries LoyaltyEntry[]
  @@unique([userId, checkoutKey])
  @@index([outletId, status, createdAt])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([createdAt, outletId])
  @@index([outletId, estimateSource, placedAt])
}

model MenuCityPrice {
  itemId String
  city String
  pricePaise Int
  familyPricePaise Int?
  item MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@id([itemId, city])
}

model Coupon {
  code String @id
  version Int @default(0)
  description String
  type String
  value Int
  minSubtotalPaise Int
  maxDiscountPaise Int
  firstOrderOnly Boolean @default(false)
  active Boolean @default(true)
  startsAt DateTime
  expiresAt DateTime
}

model LoyaltyEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  orderId String?
  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind String
  points Int
  createdAt DateTime @default(now())
  @@unique([orderId, kind])
  @@index([userId, createdAt])
}

model CateringRequest {
  id String @id @default(cuid())
  number String @unique
  userId String
  user User @relation(fields: [userId], references: [id])
  outletId String
  outlet Outlet @relation(fields: [outletId], references: [id])
  requestKey String
  requestHash String
  eventAt DateTime
  guestCount Int
  occasion String
  contactName String
  phone String
  address String
  menuNotes String
  budgetPaise Int?
  status CateringStatus @default(REQUESTED)
  managerNote String @default("")
  respondedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(0)
  @@unique([userId, requestKey])
  @@index([outletId, status, eventAt])
  @@index([userId, createdAt])
}

model OrderLine {
  id          String @id @default(cuid())
  orderId     String
  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId      String
  name        String
  photo       String?
  portion     String
  quantity    Int
  unitPaise   Int
  addOns      Json
}

model Payment {
  id          String @id @default(cuid())
  orderId     String
  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attemptKey  String
  method      String
  provider String @default("demo")
  testMode Boolean @default(true)
  providerPaymentId String? @unique
  providerRefundId String? @unique
  refundReviewRequired Boolean @default(false)
  providerRefundedPaise Int @default(0)
  refundReason String?
  refundNextAttemptAt DateTime?
  refundLeaseUntil DateTime?
  refundAttempts Int @default(0)
  status      PaymentStatus
  amountPaise Int
  resolveAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([orderId, attemptKey])
  @@index([status, resolveAt])
  @@index([provider, status, refundNextAttemptAt])
}

model Message {
  id        String @id @default(cuid())
  orderId   String
  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      String
  deliveries MessageDelivery[]
  body      String
  createdAt DateTime @default(now())
  @@unique([orderId, kind])
}

model Audit {
  id        String @id @default(cuid())
  orderId   String?
  order     Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User? @relation(fields: [actorId], references: [id])
  action    String
  detail    String
  createdAt DateTime @default(now())
}

model RateLimit {
  key       String @id
  hits      Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

model PhoneOtp {
  id String @id
  provider String @default("demo")
  providerId String?
  userId String?
  purpose String @default("sign_in")
  phone String
  codeHash String
  name String
  consentAt DateTime
  marketingOptIn Boolean @default(false)
  attempts Int @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model ChannelBaseline {
  id String @id @default(cuid())
  outletId String
  outlet Outlet @relation(fields: [outletId], references: [id])
  periodStart DateTime
  periodEnd DateTime
  appOrders Int
  source String
  recordedAt DateTime @default(now())
  @@unique([outletId, periodStart, periodEnd])
}

model GatewayOrder {
  testMode Boolean @default(true)
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receipt String @unique
  providerOrderId String? @unique
  leaseUntil DateTime?
  nextCheckAt DateTime @default(now())
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([nextCheckAt])
}

model EmailOtp {
  id String @id
  email String
  codeHash String
  name String
  consentAt DateTime
  marketingOptIn Boolean @default(false)
  attempts Int @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  provider String @default("demo")
  userId String?
  purpose String @default("sign_in")
  registrationPhone String?
  @@index([expiresAt])
}

model PasswordReset {
  id String @id
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel String
  contactHash String
  credentialVersion String?
  roleSnapshot String?
  provider String
  providerId String?
  codeHash String
  attempts Int @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  sentAt DateTime?
  createdAt DateTime @default(now())
  @@index([expiresAt])
  @@index([contactHash])
  @@index([userId])
}

model MessageDelivery {
  provider String @default("legacy")
  id String @id @default(cuid())
  messageId String
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  channel String
  status String @default("PENDING")
  providerId String?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  recipientHash String?
  firstAttemptAt DateTime?
  leaseToken String?
  leasedUntil DateTime?
  lastErrorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([messageId, channel])
  @@index([status, nextAttemptAt])
}

model WorkerStatus {
  id String @id @default(cuid())
  processId String
  job String
  startedAt DateTime?
  finishedAt DateTime?
  succeededAt DateTime?
  failedAt DateTime?
  consecutiveFailures Int @default(0)
  lastErrorCode String?
  updatedAt DateTime @updatedAt
  @@unique([processId, job])
  @@index([updatedAt])
}

model GatewayWebhook {
  id String @id @default(cuid())
  dedupeKey String @unique
  event String
  paymentId String?
  refundId String?
  refundPaymentId String?
  testMode Boolean
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseToken String?
  leasedUntil DateTime?
  lastErrorCode String?
  receivedAt DateTime @default(now())
  processedAt DateTime?
  updatedAt DateTime @updatedAt
  @@index([status, testMode, nextAttemptAt])
  @@index([status, leasedUntil])
}
