# Copy to .env and supply your own PostgreSQL connection string.
DATABASE_URL=
# Enable explicit demo sign-in shortcuts and the simulated payment gateway.
DEMO_MODE=true
APP_ORIGIN=http://127.0.0.1:3000
# Set before seeding. Never use the demo password for a public production service.
DEMO_PASSWORD=
# Containers run a separate worker; local development defaults to embedded jobs.
RUN_BACKGROUND_JOBS=true
# Public demos require explicit acknowledgement, in addition to DEMO_MODE=true.
ALLOW_PUBLIC_DEMO=false
# Public staging with real sign-in/email and Razorpay test keys requires this opt-in.
# Test payments do not collect real money. Disable before switching to live keys.
ALLOW_PUBLIC_TEST_PAYMENTS=false
# Set to a real operator contact before accepting live customer data.
PRIVACY_CONTACT=
# Optional durable image directory. Default: .local/uploads.
UPLOAD_DIR=
# Compose only: use a long random hexadecimal password (URL-safe).
POSTGRES_PASSWORD=

# Gateway selection: demo requires DEMO_MODE=true; use razorpay for hosted checkout.
PAYMENT_PROVIDER=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional previous webhook signing secret during a controlled secret rotation.
RAZORPAY_PREVIOUS_WEBHOOK_SECRET=
SUPPORT_EMAIL=

# Lowest-usage-cost default: Amazon SES email. Use an IAM role/default AWS credentials.
EMAIL_PROVIDER=ses
SMS_PROVIDER=aws
AWS_REGION=ap-south-1
EMAIL_FROM=
# Defaults below are off until sender identities and production access are verified.
TRANSACTIONAL_EMAIL_ENABLED=false
TRANSACTIONAL_SMS_ENABLED=false
AWS_SMS_ORIGINATION_IDENTITY=
AWS_SMS_ENTITY_ID=
AWS_SMS_OTP_TEMPLATE_ID=
# Exact approved DLT template with {{code}} substituted by the application.
AWS_SMS_OTP_TEMPLATE=
AWS_SMS_UPDATE_TEMPLATE_ID=
# Approved DLT text: {{orderNumber}} and {{status}} recommended; {{orderId}} can follow your static URL. Each substituted variable is limited to 30 characters.
AWS_SMS_UPDATE_TEMPLATE=
AWS_SMS_MAX_PRICE_USD=0.05

# Optional alternatives. Only read when EMAIL_PROVIDER=resend / SMS_PROVIDER=twilio.
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=
