{
  "name": "isocodelabs-kitchen",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --env-file=.env scripts/verify-core.mjs --e2e",
    "test:performance": "node --env-file=.env scripts/verify-core.mjs --performance",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:local": "node scripts/local-db.mjs",
    "worker": "node --env-file=.env --import tsx scripts/worker.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "db:stop": "node scripts/local-db.mjs stop",
    "test:integration": "node --env-file=.env scripts/verify-core.mjs --integration",
    "verify:core": "npm run db:migrate && npm run db:seed && npm run check && node --env-file=.env scripts/verify-core.mjs",
    "test:soak": "node --env-file=.env scripts/verify-soak.mjs",
    "package:source": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "7.10.1",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild": true
  },
  "type": "module"
}
